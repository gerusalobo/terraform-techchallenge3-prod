//Auth

RDS_AUTH_PWD=$(aws secretsmanager get-secret-value \
  --secret-id tech-challenge/rds-auth \
  --profile prod \
  --region us-east-1 \
  --query SecretString \
  --output text | jq -r '.password')

  kubectl run postgres-client \
  --rm -it \
  --restart=Never \
  --image=postgres:15-alpine \
  --env="PGPASSWORD=$RDS_AUTH_PWD" \
  -- \
  psql \
    -h rds-auth.cc7ss20oaani.us-east-1.rds.amazonaws.com \
    -U auth_user \
    -d auth_db


